{
  "name": "lab40",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação-base para avaliação prática de CI/CD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:spec": "node --test --test-reporter=spec",
    "lint": "eslint .",
    "format": "prettier --write src/features/feature07.js test scripts eslint.config.js",
    "format:check": "prettier --check src/features/feature07.js test scripts eslint.config.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
